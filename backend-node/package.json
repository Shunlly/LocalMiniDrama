{
  "name": "LocalMiniDrama-backend",
  "version": "1.3.3",
  "description": "Node.js backend for LocalMiniDrama",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "backup:data": "node scripts/backup-data.js",
    "restore:data": "node scripts/restore-data.js",
    "maintenance:recover": "node scripts/recover-maintenance.js",
    "check": "node scripts/check-js.js src test scripts",
    "test": "node --test --test-concurrency=1",
    "audit": "node scripts/audit-flow.js",
    "verify": "npm run check && npm run test && npm run audit"
  },
  "engines": {
    "node": ">=20.0.0 <21"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@volcengine/openapi": "^1.36.2",
    "adm-zip": "0.6.0",
    "better-sqlite3": "^11.6.0",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "js-yaml": "^4.3.2",
    "jsonrepair": "^3.13.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "4.10.38",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "@volcengine/openapi": {
      "axios": "^1.18.1",
      "form-data": "^3.0.5",
      "protobufjs": "7.6.5",
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "smol-toml": "1.7.0"
  }
}

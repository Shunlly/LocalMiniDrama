.git
**/node_modules
**/dist
**/data
**/.env
**/*.db
**/*.db-shm
**/*.db-wal
desktop/dist
desktop/backend-app-secure
desktop/release*
backend-node/deploy-pack
backend-node/tools/ffmpeg/*.exe

# Local configuration and credential material must not enter the build context.
**/configs/**
!backend-node/configs
!backend-node/configs/config.yaml
**/ai-configs/**
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Generated Electron staging and release artifacts are never Docker inputs.
desktop/backend-app
desktop/backend-app-secure
desktop/frontweb-dist
desktop/release
desktop/release-*

{
  "name": "LocalMiniDrama-film",
  "version": "1.3.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <21"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-budget.cjs",
    "preview": "vite preview",
    "check": "node scripts/check-js.cjs src test scripts",
    "e2e:smoke": "node scripts/e2e-smoke.cjs",
    "e2e:free-canvas": "node scripts/e2e-free-canvas.cjs",
    "verify:free-canvas-evidence": "node scripts/verify-free-canvas-evidence.cjs",
    "e2e:production:raw": "node scripts/e2e-production.cjs",
    "e2e:production": "npm run e2e:production:raw && npm run verify:acceptance-report:final && npm run e2e:free-canvas && npm run verify:free-canvas-evidence",
    "test": "node --test",
    "verify:acceptance-report": "node scripts/verify-acceptance-report.cjs --mode=tracked",
    "verify:acceptance-report:final": "node scripts/verify-acceptance-report.cjs --mode=final --evidence-root ../artifacts/e2e-production",
    "verify": "npm run check && npm run test && npm run verify:acceptance-report && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.18.1",
    "element-plus": "^2.5.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "acorn": "^8.17.0",
    "playwright": "^1.61.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.4"
  },
  "overrides": {
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "postcss": "^8.5.19"
  }
}

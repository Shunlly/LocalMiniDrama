FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS build

WORKDIR /app

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY frontweb/package*.json ./
RUN npm ci --include=dev --no-audit

COPY frontweb/index.html ./index.html
COPY frontweb/vite.config.js ./vite.config.js
COPY frontweb/public ./public
COPY frontweb/src ./src
COPY frontweb/scripts ./scripts
COPY frontweb/test ./test
COPY backend-node/src/utils/runtimeInstanceId.js /backend-node/src/utils/runtimeInstanceId.js

ENV NODE_ENV=production
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6 AS runtime

USER root
# Bump when Alpine packages in the pinned nginx image need a security refresh.
ARG ALPINE_PACKAGE_REFRESH=20260827
RUN apk upgrade --no-cache

COPY frontweb/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

ARG LOCALMINIDRAMA_BUILD_REVISION=unknown
LABEL org.opencontainers.image.revision="${LOCALMINIDRAMA_BUILD_REVISION}"

USER 101

EXPOSE 3013

HEALTHCHECK --interval=10s --timeout=3s --retries=6 \
  CMD wget -q -O - http://127.0.0.1:3013/healthz >/dev/null 2>&1 || exit 1
